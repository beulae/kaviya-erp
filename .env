# Base URL for the REST API. Leave as /api/v1 when running behind the
# bundled Nginx reverse proxy (see nginx/nginx.conf); point it at an
# absolute URL (e.g. http://localhost:4000/api/v1) for local dev against
# a standalone backend.
VITE_API_BASE_URL=/api

DATABASE_URL="postgresql://postgres:sql@360@localhost:5432/logistics?schema=public"